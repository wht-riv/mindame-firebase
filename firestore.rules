rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function shortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }

    match /participantsV4/{uid} {
      allow get: if mine(uid);
      allow create: if mine(uid) && request.resource.data.ownerUid == uid;
      allow update: if mine(uid) && resource.data.ownerUid == uid && request.resource.data.ownerUid == uid;
      allow list, delete: if false;

      match /records/{recordId} {
        allow get, list: if mine(uid);
        allow create: if mine(uid)
          && request.resource.data.ownerUid == uid
          && shortText(request.resource.data.predictedExcuse, 100)
          && shortText(request.resource.data.firstStepText, 100);
        allow update: if mine(uid) && resource.data.ownerUid == uid && request.resource.data.ownerUid == uid;
        allow delete: if false;
      }
    }

    match /publicPostsV4/{postId} {
      allow get, list: if signedIn() && resource.data.isVisible == true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isVisible == true
        && shortText(request.resource.data.excuseText, 100);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVisible']);
      allow delete: if false;

      match /reactions/{uid} {
        allow get, list: if signedIn();
        allow create, update: if mine(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.type == 'seed';
        allow delete: if mine(uid);
      }

      match /replies/{uid} {
        allow read, write: if false;
      } {
        allow get, list: if signedIn();
        allow create, update: if mine(uid)
          && request.resource.data.ownerUid == uid
          && shortText(request.resource.data.text, 60);
        allow delete: if mine(uid);
      }
    }
  }
}
